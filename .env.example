# SERVIDOR: configurar em Vercel > Project > Settings > Environment Variables
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=obtenha-no-painel-do-supabase

# NAVEGADOR: chave publica (anon/publishable), NUNCA service_role
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=obtenha-a-chave-publica

# SERVIDOR SOMENTE: importação de customizadas (sem prefixo VITE_)
HENRIK_API_KEY=configure-no-painel-da-henrikdev
