{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/admin/home-feature",
      "destination": "/api/index?route=admin/home-feature"
    },
    {
      "source": "/api/home/featured",
      "destination": "/api/index?route=home/featured"
    },
    {
      "source": "/api/admin/accounts/:id/status",
      "destination": "/api/index?route=admin/accounts/:id/status"
    },
    {
      "source": "/api/admin/accounts/:id/password",
      "destination": "/api/index?route=admin/accounts/:id/password"
    },
    {
      "source": "/api/admin/accounts/:id",
      "destination": "/api/index?route=admin/accounts/:id"
    },
    {
      "source": "/api/admin/accounts",
      "destination": "/api/index?route=admin/accounts"
    },
    {
      "source": "/api/scrims/:id/owner",
      "destination": "/api/index?route=scrims/:id/owner"
    },
    {
      "source": "/api/admin/login",
      "destination": "/api/index?route=admin/login"
    },
    {
      "source": "/api/admin/session",
      "destination": "/api/index?route=admin/session"
    },
    {
      "source": "/api/admin/logout",
      "destination": "/api/index?route=admin/logout"
    },
    {
      "source": "/api/scrims/:id/tools",
      "destination": "/api/index?route=scrims/:id/tools"
    },
    {
      "source": "/api/scrims/:id/imports",
      "destination": "/api/index?route=scrims/:id/imports"
    },
    {
      "source": "/api/scrims/:id/report.md",
      "destination": "/api/index?route=scrims/:id/report.md"
    },
    {
      "source": "/api/scrims/:id/command",
      "destination": "/api/index?route=scrims/:id/command"
    },
    {
      "source": "/api/scrims/:id/session",
      "destination": "/api/index?route=scrims/:id/session"
    },
    {
      "source": "/api/scrims/:id/access",
      "destination": "/api/index?route=scrims/:id/access"
    },
    {
      "source": "/api/scrims/:id",
      "destination": "/api/index?route=scrims/:id"
    },
    {
      "source": "/api/scrims",
      "destination": "/api/index?route=scrims"
    },
    {
      "source": "/api/health",
      "destination": "/api/index?route=health"
    },
    {
      "source": "/preview.html",
      "destination": "/preview.html"
    },
    {
      "source": "/guia-admin.html",
      "destination": "/guia-admin.html"
    },
    {
      "source": "/guia-admin.pdf",
      "destination": "/guia-admin.pdf"
    },
    {
      "source": "/pilotos/:path*",
      "destination": "/pilotos/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "vite --host 0.0.0.0 --port $PORT"
}
